{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "C:/Users/sky/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#FF8CB0",
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " ",
    "size": { 
      "binaryPrefix": "jedec" 
    } 
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#FF8CB0",
        "at": "#FFFFFF",
        "host": "#B28CFF"
      }
    },
    "break",
    {
      "type": "os",
      "key": "OS",
      "keyColor": "#FF8C8C"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "#ffbd8c"
    },
    {
      "type": "display",
      "key": "Display",
      "keyColor": "#FFF08C"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "#8CFF8C"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "#8CF8FF",
      "hideType": "unknown"
    },
    {
      "type": "board",
      "key": "Motherboard",
      "keyColor": "#8C9CFF"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "#B28CFF",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "#FF8CB0",
      "folders": "/"
    },
    {
      "type": "localip",
      "key": "Local IP",
      "keyColor": "#FF8C8C"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
    },
	"break"
  ]
}
